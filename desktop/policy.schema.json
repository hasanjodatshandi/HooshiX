{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hooshix.local/schemas/desktop-policy-v1.json",
  "title": "HooshiX developer-host Desktop MCP policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "winapp_path",
    "expected_winapp_version",
    "allow_all_apps",
    "allowed_apps",
    "denied_apps",
    "audit_log",
    "capture_temp_dir",
    "require_interactive_session",
    "require_non_elevated",
    "allow_screenshot",
    "allow_capture_screen",
    "allow_uia_mutation",
    "allow_mouse_input",
    "allow_keyboard_input",
    "allow_system_keys",
    "max_command_seconds",
    "max_output_bytes",
    "max_screenshot_bytes",
    "max_text_chars",
    "max_inspect_depth",
    "max_audit_bytes",
    "audit_backups"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "winapp_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "expected_winapp_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "allow_all_apps": {"type": "boolean"},
    "allowed_apps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "denied_apps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "audit_log": {"type": "string", "minLength": 1, "maxLength": 4096},
    "capture_temp_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
    "require_interactive_session": {"type": "boolean"},
    "require_non_elevated": {"type": "boolean"},
    "allow_screenshot": {"type": "boolean"},
    "allow_capture_screen": {"type": "boolean"},
    "allow_uia_mutation": {"type": "boolean"},
    "allow_mouse_input": {"type": "boolean"},
    "allow_keyboard_input": {"type": "boolean"},
    "allow_system_keys": {"type": "boolean"},
    "allow_credential_input": {"type": "boolean"},
    "credential_bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["credential_id", "app", "executable_path", "executable_sha256", "target_selector", "credential_target"],
        "properties": {
          "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "app": {"type": "string", "minLength": 1, "maxLength": 128},
          "executable_path": {"type": "string", "minLength": 3, "maxLength": 4096},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "target_selector": {"type": "string", "minLength": 1, "maxLength": 512},
          "credential_target": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "additionalProperties": false
      }
    },
    "max_command_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "max_output_bytes": {"type": "integer", "minimum": 4096, "maximum": 16777216},
    "max_screenshot_bytes": {"type": "integer", "minimum": 65536, "maximum": 33554432},
    "max_text_chars": {"type": "integer", "minimum": 1, "maximum": 16384},
    "max_inspect_depth": {"type": "integer", "minimum": 1, "maximum": 12},
    "max_audit_bytes": {"type": "integer", "minimum": 1048576, "maximum": 1073741824},
    "audit_backups": {"type": "integer", "minimum": 1, "maximum": 20}
  },
  "additionalProperties": false
}
