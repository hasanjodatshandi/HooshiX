root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.{java,kt,kts}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
