{
  "name": "hooshix-web-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "generate:api": "./scripts/generate-openapi-client.sh",
    "check:api": "./scripts/check-openapi-client.sh",
    "test:components": "vitest run",
    "test:a11y": "playwright test --grep @a11y",
    "e2e": "playwright test --grep-invert @a11y"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "latest",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.9.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "4.1.11"
  }
}
