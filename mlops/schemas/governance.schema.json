{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hooshix.internal/schemas/mlops/governance-v1.json",
  "title": "HooshiX model-execution governance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "governance_version", "decision_status", "model_catalog", "prompt_catalog", "price_catalog", "promotion_policy", "safety_policy", "provider_data_controls", "feedback_policy", "drift_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "governance_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "decision_status": {"const": "APPROVED_ARCHITECTURE_RUNTIME_DISABLED"},
    "model_catalog": {"type": "array", "minItems": 1},
    "prompt_catalog": {"type": "array", "minItems": 1},
    "price_catalog": {"type": "array", "minItems": 1},
    "promotion_policy": {"type": "object"},
    "safety_policy": {"type": "object"},
    "provider_data_controls": {"type": "object"},
    "feedback_policy": {"type": "object"},
    "drift_policy": {"type": "object"}
  }
}
