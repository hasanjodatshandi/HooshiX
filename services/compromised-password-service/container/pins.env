# Exact runtime construction inputs for linux/amd64.
# Temurin 25.0.4+7 is supplied by the SHA-pinned setup-java CI step; the final image uses the pinned Ubuntu base below.
# Runtime construction uses no floating Java image tag and CI verifies the final JVM version.
RUNTIME_BASE_IMAGE=ubuntu@sha256:52df9b1ee71626e0088f7d400d5c6b5f7bb916f8f0c82b474289a4ece6cf3faf
TEMURIN_JAVA_VERSION=25.0.4
TEMURIN_BUILD=7
