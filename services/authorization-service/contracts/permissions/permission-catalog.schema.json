{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "permissions"],
  "properties": {
    "version": {"const": 1},
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "scope", "lifecycle"],
        "properties": {
          "key": {"type": "string", "maxLength": 128, "pattern": "^(?:[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+|platform\\.legal_hold\\.manage)$"},
          "scope": {"enum": ["TENANT", "PLATFORM"]},
          "lifecycle": {"enum": ["ACTIVE", "DEPRECATED", "RETIRED"]}
        }
      }
    }
  }
}
