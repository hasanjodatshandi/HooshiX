{
  "title": "HooshiX Authorization Service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"type":"timeseries","title":"gRPC request rate","targets":[{"expr":"sum by (operation) (rate(authorization_grpc_server_duration_seconds_count{job=\"authorization-service\"}[5m]))"}],"gridPos":{"h":8,"w":12,"x":0,"y":0}},
    {"type":"timeseries","title":"gRPC non-OK rate","targets":[{"expr":"sum by (operation,outcome) (rate(authorization_grpc_server_duration_seconds_count{job=\"authorization-service\",outcome!=\"OK\"}[5m]))"}],"gridPos":{"h":8,"w":12,"x":12,"y":0}},
    {"type":"timeseries","title":"gRPC p95 latency","targets":[{"expr":"histogram_quantile(0.95, sum by (le,operation) (rate(authorization_grpc_server_duration_seconds_bucket{job=\"authorization-service\"}[5m])))"}],"gridPos":{"h":8,"w":12,"x":0,"y":8}},
    {"type":"timeseries","title":"gRPC in flight","targets":[{"expr":"authorization_grpc_server_in_flight{job=\"authorization-service\"}"}],"gridPos":{"h":8,"w":12,"x":12,"y":8}},
    {"type":"timeseries","title":"Admin quota outcomes","targets":[{"expr":"sum by (outcome) (rate(authorization_admin_quota_duration_seconds_count{job=\"authorization-service\"}[5m]))"}],"gridPos":{"h":8,"w":12,"x":0,"y":16}},
    {"type":"timeseries","title":"Admin quota p95 latency","targets":[{"expr":"histogram_quantile(0.95, sum by (le,outcome) (rate(authorization_admin_quota_duration_seconds_bucket{job=\"authorization-service\"}[5m])))"}],"gridPos":{"h":8,"w":12,"x":12,"y":16}},
    {"type":"timeseries","title":"CheckPermission p99 latency","targets":[{"expr":"histogram_quantile(0.99, sum by (le) (rate(authorization_grpc_server_duration_seconds_bucket{job=\"authorization-service\",operation=\"CheckPermission\"}[5m])))"}],"gridPos":{"h":8,"w":12,"x":0,"y":24}},
    {"type":"timeseries","title":"CheckPermission admission pressure","targets":[{"expr":"authorization_check_permission_in_flight{job=\"authorization-service\"}","legendFormat":"in flight"},{"expr":"authorization_check_permission_max_caller_in_flight{job=\"authorization-service\"}","legendFormat":"max caller in flight"},{"expr":"authorization_check_permission_queue_depth{job=\"authorization-service\"}","legendFormat":"queue depth"}],"gridPos":{"h":8,"w":12,"x":12,"y":24}},
    {"type":"timeseries","title":"CheckPermission queue wait p99","targets":[{"expr":"histogram_quantile(0.99, sum by (le,outcome) (rate(authorization_check_permission_queue_wait_seconds_bucket{job=\"authorization-service\"}[5m])))"}],"gridPos":{"h":8,"w":12,"x":0,"y":32}},
    {"type":"timeseries","title":"CheckPermission shed rate","targets":[{"expr":"sum by (reason) (rate(authorization_check_permission_shed_total{job=\"authorization-service\"}[5m]))","legendFormat":"{{reason}}"}],"gridPos":{"h":8,"w":12,"x":12,"y":32}},
    {"type":"timeseries","title":"Owner reservation oldest unresolved age","targets":[{"expr":"authorization_owner_reservation_oldest_unresolved_age_seconds{job=\"authorization-service\"}","legendFormat":"seconds"}],"gridPos":{"h":8,"w":12,"x":0,"y":40}},
    {"type":"timeseries","title":"Required audit failures","targets":[{"expr":"sum(increase(authorization_security_audit_failures_total{job=\"authorization-service\"}[5m]))","legendFormat":"failures / 5m"}],"gridPos":{"h":8,"w":12,"x":12,"y":40}},
    {"type":"timeseries","title":"CheckPermission service-side availability error ratio","targets":[{"expr":"sum(rate(authorization_grpc_server_duration_seconds_count{job=\"authorization-service\",operation=\"CheckPermission\",outcome=~\"UNAVAILABLE|RESOURCE_EXHAUSTED|DEADLINE_EXCEEDED|INTERNAL\"}[5m])) / clamp_min(sum(rate(authorization_grpc_server_duration_seconds_count{job=\"authorization-service\",operation=\"CheckPermission\",outcome=~\"OK|PERMISSION_DENIED|UNAVAILABLE|RESOURCE_EXHAUSTED|DEADLINE_EXCEEDED|INTERNAL\"}[5m])), 0.001)"}],"gridPos":{"h":8,"w":24,"x":0,"y":48}}
  ]
}