{
  "title": "HooshiX Authorization Service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"type":"timeseries","title":"gRPC request rate","targets":[{"expr":"sum by (operation) (rate(authorization_grpc_server_duration_seconds_count{job=\"authorization-service\"}[5m]))"}],"gridPos":{"h":8,"w":12,"x":0,"y":0}},
    {"type":"timeseries","title":"gRPC non-OK rate","targets":[{"expr":"sum by (operation,outcome) (rate(authorization_grpc_server_duration_seconds_count{job=\"authorization-service\",outcome!=\"OK\"}[5m]))"}],"gridPos":{"h":8,"w":12,"x":12,"y":0}},
    {"type":"timeseries","title":"gRPC p95 latency","targets":[{"expr":"histogram_quantile(0.95, sum by (le,operation) (rate(authorization_grpc_server_duration_seconds_bucket{job=\"authorization-service\"}[5m])))"}],"gridPos":{"h":8,"w":12,"x":0,"y":8}},
    {"type":"timeseries","title":"gRPC in flight","targets":[{"expr":"authorization_grpc_server_in_flight{job=\"authorization-service\"}"}],"gridPos":{"h":8,"w":12,"x":12,"y":8}},
    {"type":"timeseries","title":"Admin quota outcomes","targets":[{"expr":"sum by (outcome) (rate(authorization_admin_quota_duration_seconds_count{job=\"authorization-service\"}[5m]))"}],"gridPos":{"h":8,"w":12,"x":0,"y":16}},
    {"type":"timeseries","title":"Admin quota p95 latency","targets":[{"expr":"histogram_quantile(0.95, sum by (le,outcome) (rate(authorization_admin_quota_duration_seconds_bucket{job=\"authorization-service\"}[5m])))"}],"gridPos":{"h":8,"w":12,"x":12,"y":16}}
  ]
}