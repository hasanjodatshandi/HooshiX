+func newErrorCb(logger *zap.Logger) func(types.MatchedRule) {
+	return func(mr types.MatchedRule) {
+		// ErrorLog, Message and Data may expand credentials or request bodies.
+		log := logger.With(zap.Int("rule_id", mr.Rule().ID()),
+			zap.Int("severity", int(mr.Rule().Severity())))
+		const logMsg = "waf_rule_match"
+		switch mr.Rule().Severity() {
+		case types.RuleSeverityEmergency,
+			types.RuleSeverityAlert,
+			types.RuleSeverityCritical,
+			types.RuleSeverityError:
+			log.Error(logMsg)
+		case types.RuleSeverityWarning:
+			log.Warn(logMsg)
+		case types.RuleSeverityNotice:
+			log.Info(logMsg)
+		case types.RuleSeverityInfo:
+			log.Info(logMsg)
+		case types.RuleSeverityDebug:
+			log.Debug(logMsg)
+		default:
+			log.Warn(logMsg)
+		}
+	}
+}
