# HooshiX production host audit policy. Metadata and command execution only;
# never place private keys, tokens, passwords, or request bodies in audit rules.
-D
-b 8192
-f 2
-w /etc/ssh -p wa -k hooshix-ssh-config
-w /etc/sudoers -p wa -k hooshix-privilege-config
-w /etc/sudoers.d -p wa -k hooshix-privilege-config
-w /etc/wireguard -p wa -k hooshix-wireguard-config
-w /etc/nftables.conf -p wa -k hooshix-firewall-config
-w /etc/systemd/system -p wa -k hooshix-service-config
-w /etc/rancher/k3s -p wa -k hooshix-k3s-config
-w /var/lib/rancher/k3s/server/audit -p wa -k hooshix-kubernetes-audit
-w /var/lib/postgresql -p wa -k hooshix-database-config
-w /usr/bin/sudo -p x -k hooshix-sudo
-w /usr/bin/ssh -p x -k hooshix-ssh
-w /usr/sbin/sshd -p x -k hooshix-ssh
-w /usr/local/bin/k3s -p x -k hooshix-kubernetes
-a always,exit -F arch=b64 -S execve,execveat -F auid>=1000 -F auid!=4294967295 -k hooshix-process
-a always,exit -F arch=b32 -S execve,execveat -F auid>=1000 -F auid!=4294967295 -k hooshix-process
-a always,exit -F arch=b64 -S setuid,setgid,setresuid,setresgid -k hooshix-privilege
-a always,exit -F arch=b32 -S setuid,setgid,setreuid,setregid -k hooshix-privilege
-w /var/log/auth.log -p wa -k hooshix-ssh-auth
-w /var/log/secure -p wa -k hooshix-ssh-auth
-e 1
