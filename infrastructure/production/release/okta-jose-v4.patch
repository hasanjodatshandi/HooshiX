+package okta
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"testing"
+	"time"
+
+	"github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+)
+
+func TestJOSEMigrationClientAssertion(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil { t.Fatal(err) }
+	encoded := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
+	signer, err := CreateKeySigner(string(encoded), "fixture-kid")
+	if err != nil { t.Fatal(err) }
+	raw, err := CreateClientAssertion("https://example.invalid", "fixture-client", signer)
+	if err != nil { t.Fatal(err) }
+	token, err := jwt.ParseSigned(raw, []jose.SignatureAlgorithm{jose.RS256})
+	if err != nil { t.Fatal(err) }
+	var claims jwt.Claims
+	if err := token.Claims(&key.PublicKey, &claims); err != nil { t.Fatal(err) }
+	if err := claims.Validate(jwt.Expected{Issuer: "fixture-client", Subject: "fixture-client", AnyAudience: jwt.Audience{"https://example.invalid/oauth2/v1/token"}, Time: time.Now()}); err != nil { t.Fatal(err) }
+	if len(token.Headers) != 1 || token.Headers[0].KeyID != "fixture-kid" { t.Fatal("signing identity changed") }
+	wrong, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil { t.Fatal(err) }
+	if token.Claims(&wrong.PublicKey, &jwt.Claims{}) == nil { t.Fatal("wrong key accepted") }
+	if _, err := jwt.ParseSigned(raw, []jose.SignatureAlgorithm{jose.HS256}); err == nil { t.Fatal("wrong algorithm accepted") }
+	if _, err := CreateKeySigner("not a key", "fixture-kid"); err == nil { t.Fatal("malformed key accepted") }
+}
+
+func TestJOSEMigrationMissingKeyID(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil { t.Fatal(err) }
+	encoded := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
+	if _, err := CreateKeySigner(string(encoded), ""); err != nil { t.Fatal(err) }
+}
