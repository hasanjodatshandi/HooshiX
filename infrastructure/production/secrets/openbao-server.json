{
  "ui": false,
  "log_format": "json",
  "log_level": "info",
  "api_addr": "https://openbao.hooshix-secrets.svc:8200",
  "cluster_addr": "https://openbao-0.openbao.hooshix-secrets.svc:8201",
  "default_lease_ttl": "15m",
  "max_lease_ttl": "1h",
  "default_max_request_duration": "10s",
  "storage": {
    "raft": {"path": "/openbao/data", "node_id": "openbao-0"}
  },
  "listener": [{"tcp": {
    "address": "0.0.0.0:8200",
    "cluster_address": "0.0.0.0:8201",
    "tls_cert_file": "/openbao/tls/tls.crt",
    "tls_key_file": "/openbao/tls/tls.key",
    "tls_min_version": "tls12",
    "max_request_size": 1048576,
    "max_request_duration": "10s"
  }}],
  "audit": [{"file": {"protected": {
    "description": "Protected OpenBao audit; export is a separate commissioning gate",
    "options": {"file_path": "/openbao/data/audit.jsonl", "mode": "0600", "log_raw": "false"}
  }}}]
}
