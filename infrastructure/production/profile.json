    "application_release_digests",
    "compromised_password_dataset_release",
    "cosign_oidc_issuer",
    "cosign_oidc_subject",
    "external_blackbox_monitor",
    "external_l4_source_cidrs",
    "measured_service_capacity_values",
    "offhost_security_audit_sink",
    "offsite_postgresql_backup_target",
    "openbao_unseal_custody",
    "production_registry",
    "production_tls_material",
    "upstream_ddos_provider_evidence",
    "wireguard_peer_inventory"
