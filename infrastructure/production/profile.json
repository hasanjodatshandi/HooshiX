    "external_host_down_monitor_required": true,
    "grafana": "13.1.3",
    "loki": "3.7.4",
    "otel_collector": "0.157.0",
    "otlp_public_ingress": false,
    "prometheus": "3.13.2",
    "tempo": "3.0.2"
  },
  "platform": {
    "argocd": "3.4.2",
    "argocd_ha": false,
    "calico": "3.32.1",
    "calico_dataplane": "standard",
    "disabled_k3s_components": [
      "flannel",
      "network-policy",
      "servicelb",
      "traefik"
