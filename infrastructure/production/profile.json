{
  "availability_claim": "non-ha-single-host",
  "edge": {
    "direct_bff_bypass_denied": true,
    "direct_origin_internet_denied": true,
    "exact_external_l4_cidr_trust_required": true,
    "forwarded_headers_insecure": false,
    "gateway_api": "1.5.1",
    "proxy_protocol": "v2",
    "proxy_protocol_insecure": false,
    "traefik": "3.7.10",
    "traefik_chart": "41.2.0",
    "waf_required": true
  },
  "human_access": {
    "fido2_required": true,
    "jit_reviewers_min": 2,
    "jit_write_minutes_max": 30,
    "keyboard_interactive_authentication": false,
    "management_overlay": "wireguard",
    "off_host_audit_required": true,
    "password_authentication": false,
    "public_ssh_denied": true,
    "root_login": false,
    "shared_keys": false,
    "touch_required": true,
    "user_verification_required": true
  },
  "kafka": {
