    "embedded_datastore": "sqlite",
    "istio_ambient": "1.30.3",
    "k3s": "v1.35.6+k3s1",
    "kubernetes": "1.35.6",
    "kyverno": "1.18.2",
    "kyverno_enforcement": "deny-fail-closed",
    "kyverno_policy_api": "policies.kyverno.io/v1",
    "schedulable_workload_nodes": 1,
    "secrets_encryption": true,
    "servers": 1,
    "strict_mtls": true
