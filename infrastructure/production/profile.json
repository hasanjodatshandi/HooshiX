    "provenance_required": true,
    "signature_required": true,
    "signed_cyclonedx_sbom_required": true,
    "syft": "1.51.0"
  },
  "workloads": {
    "availability_pdb_enabled": false,
    "hpa_enabled": false,
    "replicas": 1
  }
