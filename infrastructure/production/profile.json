  "postgresql": {
    "application_pool_budget_percent_max": 70,
    "barman_plugin": "0.13.0",
    "base_backup_minimum_frequency_hours": 24,
    "cert_manager": "1.20.3",
    "cloudnativepg": "1.30.0",
    "continuous_wal_archive": true,
    "instances": 1,
    "monthly_isolated_restore": true,
    "monthly_retained_artifact_months": 12,
    "physical_clusters": 1,
    "pitr_window_days": 35,
    "postgresql": "18.4",
    "quarterly_cold_dr": true,
    "reserved_connections_percent_min": 30,
    "runtime_migration_role_isolation": true,
    "service_database_isolation": true,
    "tls_required": true
  },
  "profile": "production-single-server",
  "redis": {
    "acl_isolation": true,
    "aof": true,
    "appendfsync": "everysec",
    "instances": 1,
    "maxmemory_policy": "noeviction",
    "tls_required": true,
    "version": "8.2.8"
  },
  "required_external_inputs": [
