{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HooshiX commit-bound work checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "recorded_at_utc",
    "project_id",
    "repository",
    "branch",
    "base_commit",
    "subject_commit",
    "objective",
    "scope",
    "completed",
    "decisions",
    "changed_paths",
    "verification",
    "risks",
    "unfinished",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,63}$"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "project_id": {"const": "hooshix"},
    "repository": {"const": "hasanjodatshandi/HooshiX"},
    "checkpoint_kind": {"enum": ["work", "post-merge"]},
    "source_checkpoint": {"type": "string", "pattern": "^context/checkpoints/[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,63}\\.json$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 255},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pull_request": {"type": ["integer", "null"], "minimum": 1},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "scope": {
      "type": "object",
      "required": ["review_mode", "routes", "bounded_contexts"],
      "properties": {
        "review_mode": {"enum": ["targeted", "full-read"]},
        "routes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "bounded_contexts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "completed": {"$ref": "#/$defs/stringList"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "authority_refs"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
          "authority_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification": {
      "type": "object",
      "required": ["passed", "failed", "not_run"],
      "properties": {
        "passed": {"$ref": "#/$defs/checkList"},
        "failed": {"$ref": "#/$defs/checkList"},
        "not_run": {"$ref": "#/$defs/checkList"}
      },
      "additionalProperties": false
    },
    "risks": {"$ref": "#/$defs/stringList"},
    "unfinished": {"$ref": "#/$defs/stringList"},
    "next_actions": {"$ref": "#/$defs/stringList"}
  },
  "allOf": [
    {
      "if": {
        "required": ["checkpoint_kind"],
        "properties": {"checkpoint_kind": {"const": "post-merge"}}
      },
      "then": {
        "required": ["source_checkpoint", "pull_request"]
      }
    }
  ],
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "checkList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "evidence"],
        "properties": {
          "check": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
